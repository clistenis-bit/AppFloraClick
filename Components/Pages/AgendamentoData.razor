@page "/agendamento-data"

@using AppFloraClick.DAO
@using AppFloraClick.Models

@inject AgendamentoDataDAO AgendamentoDAO
@inject NavigationManager Navigation

<PageTitle>Agendamento de Datas Especiais</PageTitle>

<div class="pagina-agendamento">

    <div class="painel-central">

        <div class="topo">
            <h1>Flora Click</h1>
            <p>AGENDAMENTO DE DATAS ESPECIAIS</p>
        </div>

        <div class="texto-topo">
            <h2>Nunca esqueça um momento importante</h2>

            <span>
                Cadastre aniversários, datas comemorativas e ocasiões especiais.
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensagem))
        {
            <div class="mensagem @(sucesso ? "sucesso" : "erro")">
                @mensagem
            </div>
        }

        <div class="formulario">

            <div class="campo">
                <label>Nome do Cliente</label>

                <input type="text"
                       @bind="novo.nome_cli_age"
                       placeholder="Digite o nome" />
            </div>

            <div class="campo">
                <label>Telefone</label>

                <input type="text"
                       @bind="novo.telefone_age"
                       placeholder="(69) 99999-9999" />
            </div>

            <div class="campo">
                <label>Tipo da Data</label>

                <select @bind="novo.tipo_data_age">

                    <option value="">Selecione</option>

                    <option value="Aniversário">
                        Aniversário
                    </option>

                    <option value="Dia das Mães">
                        Dia das Mães
                    </option>

                    <option value="Dia dos Namorados">
                        Dia dos Namorados
                    </option>

                    <option value="Dia dos Pais">
                        Dia dos Pais
                    </option>

                    <option value="Data Personalizada">
                        Data Personalizada
                    </option>

                </select>
            </div>

            <div class="campo">
                <label>Data</label>

                <input type="date"
                       @bind="novo.data_age" />
            </div>

            <div class="campo">
                <label>Observação</label>

                <textarea @bind="novo.observacao_age"
                              placeholder="Digite uma observação">
                </textarea>
                </div>

            </div>

            <div class="botoes">

                <button type="button"
                        class="btn-cadastrar"
                        @onclick="Cadastrar">

                    CADASTRAR DATA

                </button>

            </div>

            <div class="linha"></div>

            <h3>Datas cadastradas</h3>

            @if (agendamentos.Count == 0)
            {
                <p class="vazio">
                    Nenhuma data cadastrada ainda.
                </p>
            }
            else
            {
                <table>

                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Telefone</th>
                            <th>Tipo</th>
                            <th>Data</th>
                            <th>Ação</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in agendamentos)
                        {
                            <tr>

                                <td>
                                    @item.nome_cli_age
                                </td>

                                <td>
                                    @item.telefone_age
                                </td>

                                <td>
                                    @item.tipo_data_age
                                </td>

                                <td>
                                    @item.data_age.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <button type="button"
                                            class="btn-excluir"
                                            @onclick="() => Excluir(item.id_age)">

                                        Excluir

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

            <button type="button"
                    class="btn-voltar"
                    @onclick="Voltar">

                VOLTAR AO CATÁLOGO

            </button>

        </div>

    </div>


@code {

    private AgendamentoData novo = new()
    {
        data_age = DateTime.Today
    };

    private List<AgendamentoData> agendamentos = new();

    private string mensagem = "";

    private bool sucesso = false;


    protected override void OnInitialized()
    {
        CarregarAgendamentos();
    }


    private void Cadastrar()
    {
        if (string.IsNullOrWhiteSpace(novo.nome_cli_age))
        {
            sucesso = false;
            mensagem = "Digite o nome do cliente.";
            return;
        }

        if (string.IsNullOrWhiteSpace(novo.telefone_age))
        {
            sucesso = false;
            mensagem = "Digite o telefone.";
            return;
        }

        if (string.IsNullOrWhiteSpace(novo.tipo_data_age))
        {
            sucesso = false;
            mensagem = "Selecione o tipo da data.";
            return;
        }

        try
        {
            AgendamentoDAO.Inserir(novo);

            sucesso = true;
            mensagem = "Data cadastrada com sucesso!";

            novo = new AgendamentoData
            {
                data_age = DateTime.Today
            };

            CarregarAgendamentos();
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = "Erro ao cadastrar data: " + ex.Message;
        }
    }


    private void CarregarAgendamentos()
    {
        try
        {
            agendamentos = AgendamentoDAO.Listar();
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = "Erro ao carregar datas: " + ex.Message;
        }
    }


    private void Excluir(int id)
    {
        try
        {
            AgendamentoDAO.Excluir(id);

            sucesso = true;
            mensagem = "Data excluída com sucesso!";

            CarregarAgendamentos();
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = "Erro ao excluir: " + ex.Message;
        }
    }


    private void Voltar()
    {
        Navigation.NavigateTo("/catalogo");
    }

}
```razor
@page "/agendamento-data"
@using AppFloraClick.Models
@using AppFloraClick.DAO

<PageTitle>Agendamento de Datas Especiais</PageTitle>

<div class="pagina-agendamento">

    <div class="overlay"></div>

    <div class="painel-central">

        <div class="topo">
            <h1>Flora Click</h1>
            <p>AGENDAMENTO DE DATAS ESPECIAIS</p>
        </div>

        <div class="texto-topo">
            <h2>Nunca esqueça um momento importante</h2>

            <span>
                Cadastre aniversários, datas comemorativas e ocasiões especiais
                para receber lembretes e ofertas exclusivas.
            </span>
        </div>

        <div class="formulario">

            <div class="campo">
                <label>Nome do Cliente</label>
                <input @bind="nomeCliente" placeholder="Digite o nome" />
            </div>

            <div class="campo">
                <label>Telefone</label>
                <input @bind="telefone" placeholder="(69) 99999-9999" />
            </div>

            <div class="campo">
                <label>Tipo da Data</label>
                <select @bind="tipoData">
                    <option value="">Selecione</option>
                    <option value="Aniversário">Aniversário</option>
                    <option value="Dia das Mães">Dia das Mães</option>
                    <option value="Dia dos Namorados">Dia dos Namorados</option>
                    <option value="Dia dos Pais">Dia dos Pais</option>
                    <option value="Data Personalizada">Data Personalizada</option>
                </select>
            </div>

            <div class="campo">
                <label>Data</label>
                <input type="date" @bind="dataEspecial" />
            </div>

        </div>

        <div class="campo">
            <label>Observação</label>
            <textarea @bind="observacao"
                      placeholder="Ex.: Enviar promoção de buquê de rosas"></textarea>
        </div>

        <div class="botoes">

            <button class="btn-cadastrar"
                    @onclick="Cadastrar">
                Cadastrar Data
            </button>

        </div>

        <div class="linha"></div>

        <h3>Datas Cadastradas</h3>

        <table>

            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Telefone</th>
                    <th>Tipo</th>
                    <th>Data</th>
                    <th>Ação</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in agendamentos)
                {
                    <tr>
                        <td>@item.nome_cli_age</td>
                        <td>@item.telefone_age</td>
                        <td>@item.tipo_data_age</td>
                        <td>@item.data_age.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn-excluir"
                                    @onclick="() => Excluir(item)">
                                Excluir
                            </button>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@code {

    private Agendamento agendamento = new Agendamento();

    private List<Agendamento> agendamentos = new List<Agendamento>();

    private AgendamentoDataDAO dao = new AgendamentoDataDAO();

    private string nomeCliente = "";
    private string telefone = "";
    private string tipoData = "";
    private string observacao = "";

    private DateTime dataEspecial = DateTime.Today;

    protected override void OnInitialized()
    {
        CarregarAgendamentos();
    }

    private void Cadastrar()
    {
        agendamento.nome_cli_age = nomeCliente;
        agendamento.telefone_age = telefone;
        agendamento.tipo_data_age = tipoData;
        agendamento.data_age = dataEspecial;
        agendamento.observacao_age = observacao;

        dao.Inserir(agendamento);

        nomeCliente = "";
        telefone = "";
        tipoData = "";
        observacao = "";
        dataEspecial = DateTime.Today;

        agendamento = new Agendamento();

        CarregarAgendamentos();
    }

    private void CarregarAgendamentos()
    {
        agendamentos = dao.Listar();
    }

    private void Excluir(Agendamento item)
    {
        dao.Excluir(item.id_age);

        CarregarAgendamentos();
    }
}
```

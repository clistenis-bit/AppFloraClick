@page "/cadastro"

<PageTitle>Cadastro de Cliente - FloraClick</PageTitle>

<link href="css/FloraClick.css" rel="stylesheet" />

<section class="pagina-cadastro">

    <div class="card-cadastro">

        <h1 class="titulo-cadastro">
            FloraClick
        </h1>

        <p class="subtitulo-cadastro">
            Cadastro de Cliente
        </p>

        <div class="campo">
            <label>Nome Completo</label>
            <input type="text" placeholder="Digite seu nome completo" />
        </div>

        <div class="campo">
            <label>CPF</label>
            <input type="text" placeholder="Digite seu CPF" />
        </div>

        <div class="campo">
            <label>Telefone</label>
            <input type="text" placeholder="Digite seu telefone" />
        </div>

        <div class="campo">
            <label>E-mail</label>
            <input type="email" placeholder="Digite seu e-mail" />
        </div>

        <div class="campo">
            <label>Endereço</label>
            <input type="text" placeholder="Digite seu endereço" />
        </div>

        <div class="campo">
            <label>Cidade</label>
            <input type="text" placeholder="Digite sua cidade" />
        </div>

        <div class="campo">
            <label>Data de Nascimento</label>
            <input type="date" />
        </div>

        <div class="campo">
            <label>Flor Favorita</label>
            <select>
                <option>Rosa</option>
                <option>Girassol</option>
                <option>Orquídea</option>
                <option>Lírio</option>
                <option>Tulipa</option>
            </select>
        </div>

        <button class="botao-cadastrar">
            Cadastrar Cliente
        </button>

        <a href="/" class="botao-voltar">
            Voltar para Home
        </a>

    </div>

</section>
@page "/login"

@using AppFloraClick.DAO
@using AppFloraClick.Models
@using AppFloraClick.Services

@inject ClienteDAO ClienteDAO
@inject SessaoUsuario SessaoUsuario
@inject NavigationManager Navigation

<PageTitle>Login - Flora Click</PageTitle>

<div class="login-container">

    <div class="login-card">

        <h1>Flora Click</h1>

        <p>Entre na sua conta</p>

        <input @bind="email"
               type="email"
               placeholder="Seu e-mail" />

        <input @bind="cpf"
               placeholder="Seu CPF" />

        <button @onclick="Entrar">
            ENTRAR
        </button>

        @if (!string.IsNullOrWhiteSpace(mensagem))
        {
            <p class="mensagem">
                @mensagem
            </p>
        }

        <button class="cadastro"
                @onclick="CriarConta">

            AINDA NÃO TENHO CONTA

        </button>

    </div>

</div>

@code
{
    private string email = "";

    private string cpf = "";

    private string mensagem = "";

    private void Entrar()
    {
        mensagem = "";

        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(cpf))
        {
            mensagem = "Digite seu e-mail e CPF.";
            return;
        }

        try
        {
            Cliente? cliente =
                ClienteDAO.BuscarPorEmailCpf(email, cpf);

            if (cliente == null)
            {
                mensagem = "Cliente não encontrado. Confira os dados.";
                return;
            }

            SessaoUsuario.Entrar(cliente);

            Navigation.NavigateTo("/catalogo");
        }
        catch (Exception ex)
        {
            mensagem = "Erro ao entrar: " + ex.Message;
        }
    }

    private void CriarConta()
    {
        Navigation.NavigateTo("/cadastro");
    }
}
@page "/contato"

@using AppFloraClick.DAO
@using AppFloraClick.Models
@using AppFloraClick.Services

@inject ContatoVendedorDAO ContatoDAO
@inject SessaoUsuario SessaoUsuario

<PageTitle>Contato - Flora Click</PageTitle>

<div class="pagina-contato">

    <div class="painel-contato">

        <div class="cabecalho">

            <h1>FloraClick</h1>

            <p>FLORICULTURA</p>

            <h2>Fale com um Vendedor</h2>

            <span>
                Tire dúvidas, solicite informações ou envie uma mensagem
                para nossa equipe.
            </span>

        </div>

        @if (!string.IsNullOrWhiteSpace(mensagem))
        {
            <div class="mensagem @(sucesso ? "sucesso" : "erro")">
                @mensagem
            </div>
        }

        <div class="formulario">

            <div class="campo">

                <label>Assunto</label>

                <select @bind="contato.assunto_con">

                    <option value="">Selecione</option>

                    <option>Dúvida sobre produto</option>
                    <option>Solicitar orçamento</option>
                    <option>Acompanhar pedido</option>
                    <option>Sugestão</option>
                    <option>Outro assunto</option>

                </select>

            </div>

            <div class="campo">

                <label>Mensagem</label>

                <textarea @bind="contato.Mensagem_con"
                              placeholder="Digite sua mensagem">
                </textarea>

                </div>

                <button class="btn-enviar"
                        @onclick="Enviar">

                    ENVIAR MENSAGEM

                </button>

            </div>

            <div class="atendimento">

                <h3>Informações de Atendimento</h3>

                <div class="cards">

                    <div class="card-info">
                        <h4>WhatsApp</h4>
                        <p>(69) 99348-8865</p>
                    </div>

                    <div class="card-info">
                        <h4>E-mail</h4>
                        <p>contato@floraclick.com.br</p>
                    </div>

                    <div class="card-info">
                        <h4>Horário</h4>
                        <p>Segunda a sábado<br />08h às 18h</p>
                    </div>

                </div>

            </div>

        </div>

    </div>

@code
{
    private ContatoVendedor contato = new();

    private string mensagem = "";

    private bool sucesso;

    private void Enviar()
    {
        if (string.IsNullOrWhiteSpace(contato.assunto_con) ||
            string.IsNullOrWhiteSpace(contato.Mensagem_con))
        {
            sucesso = false;
            mensagem = "Preencha o assunto e a mensagem.";
            return;
        }

        try
        {
            ContatoDAO.Inserir(contato);

            sucesso = true;
            mensagem = "Mensagem enviada com sucesso!";

            contato = new ContatoVendedor();
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = "Erro ao enviar mensagem: " + ex.Message;
        }
    }
}
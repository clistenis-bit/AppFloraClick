@page "/contato"

<PageTitle>Contato com o Vendedor</PageTitle>

<div class="pagina-contato">

    <div class="painel-contato">

        <div class="ornamento">
            
        </div>

        <div class="cabecalho">

            <h1>FloraClick</h1>

            <p>FLORICULTURA</p>

            <h2>Fale com um Vendedor</h2>

            <span>
                Estamos prontos para ajudar você a escolher o arranjo perfeito,
                tirar dúvidas sobre produtos ou acompanhar seus pedidos.
            </span>

        </div>

        <div class="formulario">

            <div class="campo">
                <label>Nome Completo</label>
                <input type="text" placeholder="Digite seu nome" />
            </div>

            <div class="campo">
                <label>E-mail</label>
                <input type="email" placeholder="Digite seu e-mail" />
            </div>

            <div class="campo">
                <label>Telefone</label>
                <input type="text" placeholder="(69) 99999-9999" />
            </div>

            <div class="campo">
                <label>Assunto</label>

                <select>
                    <option>Dúvida sobre produto</option>
                    <option>Solicitar orçamento</option>
                    <option>Acompanhar pedido</option>
                    <option>Sugestão</option>
                    <option>Outro assunto</option>
                </select>
            </div>

            <div class="campo">
                <label>Mensagem</label>

                <textarea placeholder="Digite sua mensagem"></textarea>
            </div>

            <button class="btn-enviar">
                Enviar Mensagem
            </button>

        </div>

        <div class="atendimento">

            <h3>Informações de Atendimento</h3>

            <div class="cards">

                <div class="card-info">

                    <h4>WhatsApp</h4>
                    <p>(69) 99348-8865</p>
                </div>

                <div class="card-info">
                    <h4>E-mail</h4>
                    <p>contato@floraclickobixãodasflores.com.br</p>
                </div>

                <div class="card-info">
                    <h4>Horário</h4>
                    <p>Segunda a Sábado<br />08h às 18h</p>
                </div>

                <div class="card-info">
                    <h4>Observações</h4>
                    <p>Exceto domingos e feriados</p>
                </div>

            </div>

        </div>

    </div>

</div>
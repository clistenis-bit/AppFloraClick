                </div>

                <h2>Buquê de girassóis</h2>

                <p>R$: 50,00</p>

            </div>

            <!-- Produto 5 -->
            <div class="card">

                <img src="imagens/laco.png" class="laco">

                <div class="imagem">
                    <img src="imagens/primaveril.png">
                </div>

                <h2>Buquê primaveril</h2>


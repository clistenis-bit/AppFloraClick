            </div>

            <!-- Produto 8 -->
            <div class="card">

                <img src="imagens/laco.png" class="laco">

                <div class="imagem">
                    <img src="imagens/vermelhas.png">
                </div>

                <h2>Buquê de flores vermelhas</h2>

                <p>R$: 100,00</p>

            </div>

            <!-- Produto 9 -->
            <div class="card">

                <img src="imagens/laco.png" class="laco">

                <div class="imagem">
                    <img src="imagens/gerbera.png">
                </div>

                <h2>Buquê de Gérberas</h2>

                <p>R$: 100,00</p>

            </div>

        </div>


@page "/catalogo"

@using AppFloraClick.DAO
@using AppFloraClick.Models
@using AppFloraClick.Services

@inject ProdutoDAO ProdutoDAO
@inject SessaoUsuario SessaoUsuario
@inject NavigationManager Navigation

<PageTitle>Catálogo - Flora Click</PageTitle>

<section class="pagina-buques">

    <header class="topo">

        <img src="imagens/Anjosemfundo.png"
             class="anjo esquerda"
             alt="Flora Click">

        <div class="titulo">

            <h1>Flora Click</h1>

            <p>
                PORQUE TER FLORES É MUITO BOM
            </p>

            @if (SessaoUsuario.EstaLogado)
            {
                <span>
                    Olá, @SessaoUsuario.UsuarioLogado!.nome_cli 🌷
                </span>
            }

        </div>

        <img src="imagens/Anjo2semfundo.png"
             class="anjo direita"
             alt="Flora Click">

    </header>

    <nav class="acoes-catalogo">

        <button @onclick="Perfil">
            👤 Meu Perfil
        </button>

        <button @onclick="Agendamento">
            📅 Datas Especiais
        </button>

        <button @onclick="Contato">
            💬 Contato
        </button>

        <button @onclick="CadastroProduto">
            🌸 Cadastrar Produto
        </button>

    </nav>

    @if (produtos.Count == 0)
    {
        <div class="sem-produtos">

            <h2>Nenhum produto cadastrado ainda.</h2>

            <p>
                Cadastre seu primeiro produto para ele aparecer no catálogo.
            </p>

            <button @onclick="CadastroProduto">
                CADASTRAR PRODUTO
            </button>

        </div>
    }
    else
    {
        <div class="produtos">

            @foreach (var produto in produtos)
            {
                <div class="card">

                    <img src="imagens/laco.png"
                         class="laco"
                         alt="Flora Click">

                    <div class="imagem">

                        <img src="imagens/Buquerosarosa.png"
                             alt="@produto.nome_pro">

                    </div>

                    <h2>@produto.nome_pro</h2>

                    <p>
                        R$ @produto.preco_pro.ToString("N2")
                    </p>

                    <small>
                        @produto.categoria_pro
                    </small>

                    <span>
                        @produto.descricao_pro
                    </span>

                </div>
            }

        </div>
    }

</section>

@code
{
    private List<Produto> produtos = new();

    protected override void OnInitialized()
    {
        CarregarProdutos();
    }

    private void CarregarProdutos()
    {
        produtos = ProdutoDAO.Listar();
    }

    private void Perfil()
    {
        Navigation.NavigateTo("/perfil");
    }

    private void Agendamento()
    {
        Navigation.NavigateTo("/agendamento-data");
    }

    private void Contato()
    {
        Navigation.NavigateTo("/contato");
    }

    private void CadastroProduto()
    {
        Navigation.NavigateTo("/cadastroproduto");
    }
}
@page "/catalogo"
<h3>Catalogo</h3>
<!DOCTYPE html>
<html lang="pt-BR">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buquês</title>

    <link rel="stylesheet" href="buques.css">

    <!-- Fonte do título -->
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Montserrat:wght@300;500;700&display=swap" rel="stylesheet">
</head>

<body>

    <section class="pagina-buques">

        <header class="topo">

            <img src="imagens/anjo.png" class="anjo esquerda">

            <div class="titulo">
                <h1>Buquês</h1>

                <p>PORQUE TER FLORES É MUITO BOM</p>

                <span>PROJETO DE PDS</span>
            </div>

            <img src="imagens/anjo.png" class="anjo direita">

        </header>

        <div class="produtos">

            <!-- Produto 1 -->
            <div class="card">

                <img src="Imagens/laco.png" class="laco">

                <div class="imagem">
                    <img src="https://i.pinimg.com/736x/73/fd/1c/73fd1cc77775b3f3c74f4e5e7caeef87.jpg">
                </div>

                <h2>Buquê de rosas</h2>

                <p>R$: 200,00</p>

            </div>

            <!-- Produto 2 -->
            <div class="card">

                <img src="Imagens/laco.png" class="laco">

                <div class="imagem">
                    <img src="Imagens/Buqueflorrosa.png">
                </div>

                <h2>Buquê de rosas cor de rosa</h2>

                <p>R$: 290,00</p>

            </div>

            <!-- Produto 3 -->
            <div class="card">

                <img src="imagens/laco.png" class="laco">

                <div class="imagem">
                    <img src="imagens/tulipa.png">
                </div>

                <h2>Buquê de Tulipas</h2>

                <p>R$: 290,55</p>

            </div>

            <!-- Produto 4 -->
